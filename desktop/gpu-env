# One coherent Mesa package family, with the distribution GLVND dispatchers.
unset GALLIUM_DRIVER VTEST_SOCKET_NAME
if [ -c /dev/kgsl-3d0 ]; then
    export MESA_LOADER_DRIVER_OVERRIDE=kgsl
    export FD_KGSL_ENABLE_DMABUF=1
    export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json
    export KWIN_COMPOSE=O2ES
    # Qt Quick stays on OpenGL ES. Vulkan (Turnip) was tried session-wide on 2026-09-26 and
    # reverted: the voice assistant flashed whole grey frames while scrolling (docs/56).
    export QSG_RHI_BACKEND=opengl
    export GSK_RENDERER=gl
    export QT_QUICK_BACKEND=
    # Flatpak apps: this project's Mesa as the runtime's GL extension (rungic-flatpak-gl, docs/49)
    # instead of GL.default, which has no KGSL driver and renders with llvmpipe.
    [ ! -d /var/lib/flatpak/extension/org.freedesktop.Platform.GL.rungic ] || export FLATPAK_GL_DRIVERS=rungic
    unset LIBGL_ALWAYS_SOFTWARE LD_LIBRARY_PATH
else
    # Non-Qualcomm phones (Mali on husky): KWin keeps session's QPainter compositing, whose
    # shared-memory buffers reach the app. Qt Quick draws with GL on Mesa's llvmpipe: its
    # software scene graph left the dock and app drawer blank (docs/73). Remove inherited
    # Adreno settings so Mesa does not try the unavailable KGSL driver.
    unset MESA_LOADER_DRIVER_OVERRIDE FD_KGSL_ENABLE_DMABUF FD_KGSL_DMABUF_UBWC
    unset VK_DRIVER_FILES GSK_RENDERER FLATPAK_GL_DRIVERS LIBGL_ALWAYS_SOFTWARE
    export QSG_RHI_BACKEND=opengl
    export QT_QUICK_BACKEND=
    export KWIN_COMPOSE=Q
    # Socket presence is not health: require a bounded EGL test reporting virgl.
    # Without it, leave Mesa's existing llvmpipe selection untouched.
    if /usr/libexec/rungic-virgl-probe 2>/dev/null; then
        export GALLIUM_DRIVER=virpipe
        export VTEST_SOCKET_NAME=/mnt/android-wayland/vtest.sock
    fi
fi
