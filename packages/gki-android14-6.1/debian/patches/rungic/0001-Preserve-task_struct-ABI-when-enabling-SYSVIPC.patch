From: Rungic <noreply@rungic.invalid>
Date: Sun, 4 Oct 2026 19:30:00 +0800
Subject: Preserve task_struct ABI when enabling SYSVIPC for Rungic

Place the SYSVIPC state in Android KABI reserve slots 6 through 8, so
existing vendor modules keep their task_struct layout. Slots 3 to 8 are
unused at this ACK commit (slots 1 and 2 hold saved_state and
dmabuf_info); struct sysv_sem (one pointer, 8 bytes) takes slot 6 and
struct sysv_shm (a list_head, 16 bytes) takes slots 7 and 8.
_ANDROID_KABI_REPLACE asserts at compile time that each fits. This is
the Android 15 / 6.6 patch adapted to the Pixel 8 Pro (husky) stock
kernel 6.1.145-android14-11. The configuration fragment is maintained
separately in kernel/targets/gki/lxc_defconfig.
Forwarded: not-needed
Last-Update: 2026-10-04
X-Rungic-Status: Pending
X-Rungic-Tests: L1:husky-kernel-build,module-abi; L2:husky-boot (to write)
X-Rungic-Docs: docs/108-husky-port.md
---
 include/linux/sched.h | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 22cdf84e6a31..f8b0a09e8d6f 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -1096,10 +1096,6 @@ struct task_struct {
 
 	struct nameidata		*nameidata;
 
-#ifdef CONFIG_SYSVIPC
-	struct sysv_sem			sysvsem;
-	struct sysv_shm			sysvshm;
-#endif
 #ifdef CONFIG_DETECT_HUNG_TASK
 	unsigned long			last_switch_count;
 	unsigned long			last_switch_time;
@@ -1553,9 +1549,14 @@ struct task_struct {
 	ANDROID_KABI_RESERVE(3);
 	ANDROID_KABI_RESERVE(4);
 	ANDROID_KABI_RESERVE(5);
+#ifdef CONFIG_SYSVIPC
+	ANDROID_KABI_USE(6, struct sysv_sem sysvsem);
+	_ANDROID_KABI_REPLACE(ANDROID_KABI_RESERVE(7); ANDROID_KABI_RESERVE(8), struct sysv_shm sysvshm);
+#else
 	ANDROID_KABI_RESERVE(6);
 	ANDROID_KABI_RESERVE(7);
 	ANDROID_KABI_RESERVE(8);
+#endif
 
 	/*
 	 * New fields for task_struct should be added above here, so that
