# The kernel loop worker needs access only to the Plasma rootfs image and its copy-on-write
# store (system/rootfs-image, docs/61 §7). Without it the loop device returns I/O errors: the
# worker runs as u:r:kernel:s0, which may not read adb_data_file. Same approach as
# docker/sepolicy.rule (docs/19).
type rungic_image file_type
typeattribute rungic_image data_file_type
allow kernel rungic_image file { open read write getattr ioctl lock map }
# The container's /dev/shm carries the APK's appdomain_tmpfs label (system/init). Pixel
# policy denies associating that type with its own tmpfs superblock; Motorola's allowed it.
allow appdomain_tmpfs appdomain_tmpfs filesystem associate
