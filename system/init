#!/bin/sh
set -eu
mkdir -p /var/log/plasma
exec >>/var/log/plasma/init.log 2>&1
# These mounts are in LXC's private mount namespace.
mount -o remount,bind,suid,nodev / /
umount /dev/shm
# The APK's label on /dev/shm (KWin's shared-memory buffers); not util-linux mount, which drops
# SELinux options without selinuxfs (android-shm-mount).
/usr/libexec/rungic-android-shm-mount /var/lib/rungic-host/android-shm-context
# proc:mixed makes /proc/sys read-only. bubblewrap's --disable-userns, which
# Flatpak adds to every sandbox, writes user.max_user_namespaces from inside the
# sandbox's own user namespace (the value is per user namespace), so only
# /proc/sys/user needs to be writable; the rest of /proc/sys stays read-only.
mount --bind /proc/sys/user /proc/sys/user && mount -o remount,bind,rw /proc/sys/user ||
    echo "rungic-plasma-init: /proc/sys/user stays read-only; Flatpak sandboxes will fail"
# The kernel lets a sandbox (bubblewrap with a new PID namespace, as Flatpak uses)
# mount a fresh proc only if the mount namespace already has a fully visible
# proc, and LXC's masks over /proc/sys, sysrq-trigger and boot_id make /proc
# partly hidden. An unmasked proc in a root-only directory satisfies the check;
# sandboxes still cannot write global sysctls from their user namespace.
mkdir -p -m 0700 /run/rungic-proc && mount -t proc -o nosuid,nodev,noexec proc /run/rungic-proc ||
    echo "rungic-plasma-init: no visible proc; Flatpak sandboxes will fail"
[ -c /dev/fuse ] || mknod /dev/fuse c 10 229
chmod 0666 /dev/fuse
# The desktop account across the Rungic rename (docs/70), before any of its processes run.
/usr/libexec/rungic-rebrand-system up || echo "rungic-plasma-init: the account keeps its old home"
export container=lxc
exec /sbin/init
